{
  "name": "farmix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FARMIX (producto mínimo viable en estudio): backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
