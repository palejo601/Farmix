# Copie a .env y complete. No incluya valores reales en este archivo.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/NOMBRE_BD
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
COOKIE_SECURE=false
STATIC_DIR=
EXPOSE_DOCS=false
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=false
MAIL_MODE=dev
STORAGE_DIR=./storage
LOG_LEVEL=info

# Solo para `npm test`: base DESECHABLE (se borra y recrea su esquema public)
TEST_DATABASE_URL=postgres://USUARIO:CLAVE@localhost:5432/NOMBRE_BD_PRUEBAS
